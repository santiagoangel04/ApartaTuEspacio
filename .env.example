# URL completa de la API que guarda los registros (ver server/README.md), por ejemplo:
# VITE_LEADS_ENDPOINT=https://apartatuespacio-api.up.railway.app/api/leads
# Recibe un POST con JSON: { name, phone, email, consent, source, createdAt }
# Si se deja vacía, el formulario simula el envío (modo demo) y NO guarda nada.
VITE_LEADS_ENDPOINT=
